# PayMate configuration template. Copy to .env (gitignored) and fill ONLY what you need.
# Nothing here is required for offline MOCK mode.

# --- Server ---
PAYMATE_PORT=8787
PAYMATE_PUBLIC_BASE_URL=http://127.0.0.1:8787
# PAYMATE_DB=./data/paymate.db

# --- PayPal Sandbox adapter (OFF unless all three set AND ENABLE=true) ---
# Status: implemented, NOT integration-tested. Get free sandbox credentials at
# https://developer.paypal.com/ (account registration is a user action).
PAYMATE_ENABLE_PAYPAL=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Optional AI adapter: OpenAI-compatible endpoint (e.g. deployed WorkBuddy Gateway) ---
# Status: implemented, UNVERIFIED (quota/pricing unconfirmed). Keep disabled until confirmed.
# The URL/key stay server-side; never embed in frontend or commit them.
PAYMATE_ENABLE_AI=false
WORKBUDDY_BASE_URL=
WORKBUDDY_API_KEY=
PAYMATE_AI_MODEL=gpt-4o-mini
PAYMATE_AI_MAX_CALLS=20
